# Root env template. Docker Compose reads this file as `.env`.
# For non-Docker local dev, copy the relevant values into
# apps/backend/.env and apps/storefront/.env.local (see those .env.example files).

# --- Postgres (used by the compose postgres service) ---
# POSTGRES_PASSWORD is REQUIRED by docker-compose.yml (compose refuses to start without it).
POSTGRES_USER=tools
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=toolsvilla

# Standalone backend (outside compose) connection string:
DATABASE_URL=postgres://tools:change-me-strong-db-password@localhost:5432/toolsvilla

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxx

# --- Admin console (/admin uses this as the password) ---
ADMIN_TOKEN=change-me-long-random-string

# --- Abuse protection: per-IP limit on public write endpoints ---
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# --- Admin brute-force throttle (token guessing) ---
ADMIN_RATE_LIMIT_MAX=120
ADMIN_RATE_LIMIT_WINDOW_MS=60000

# --- Receipt lookups (invoice / track / verify) per IP per minute ---
LOOKUP_RATE_LIMIT_MAX=60

# --- Server-render cache TTL (ms). Absorbs traffic bursts without stale prices ---
SSR_CACHE_TTL_MS=10000

# --- Cash on Delivery cap (paise). Default 2000000 = ₹20,000 ---
COD_MAX_PAISE=2000000

# --- CORS: the storefront origin that may call the API ---
# Single-domain nginx setup: https://yourdomain.com
# Two subdomains:           https://shop.yourdomain.com
# Allowed browser origin(s) for the API. Comma-separated for www + apex.
# Leave empty for same-origin single-domain (/api behind nginx needs no CORS entry).
FRONTEND_URL=http://localhost:3000

# --- Frontend (NEXT_PUBLIC_* are baked in at BUILD time — rebuild to change) ---
# Single domain via nginx: https://yourdomain.com/api   |   two domains: https://api.yourdomain.com
# Where the browser calls the API.
#   Production (single domain behind nginx): /api
#   Local dev without nginx:                http://localhost:9000
# Baked into the JS bundle at build time — changing it needs a rebuild.
NEXT_PUBLIC_BACKEND_URL=/api

# Where *the server* reaches the API (SSR, metadata, /sitemap.xml rewrite).
# Must be absolute and resolvable from the storefront container.
BACKEND_INTERNAL_URL=http://backend:9000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
NEXT_PUBLIC_STORE_NAME=ToolsKart
NEXT_PUBLIC_STORE_PHONE=919999999999
NEXT_PUBLIC_STORE_EMAIL=care@toolskart.in
NEXT_PUBLIC_STORE_GSTIN=00AAAAA0000A1Z5
# Public storefront origin, used for canonical/OG URLs and the sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
