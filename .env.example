# Root env template. Docker Compose reads this file as `.env`.
# For non-Docker local dev, copy the relevant values into
# apps/backend/.env and apps/storefront/.env.local (see those .env.example files).

# --- Postgres (used by the compose postgres service) ---
# POSTGRES_PASSWORD is REQUIRED by docker-compose.yml (compose refuses to start without it).
POSTGRES_USER=tools
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=toolsvilla

# Standalone backend (outside compose) connection string:
DATABASE_URL=postgres://tools:change-me-strong-db-password@localhost:5432/toolsvilla

# --- Postgres pool limits (each has a safe default; tune for your VPS) ---
# Caps concurrent clients so the API can't exhaust Postgres connection slots.
DB_POOL_MAX=10
# Give up waiting for a connection instead of hanging the request (ms).
DB_CONNECT_TIMEOUT_MS=5000
# Recycle idle clients (ms).
DB_IDLE_TIMEOUT_MS=30000
# Abort a single runaway query instead of pinning a connection (ms).
DB_STATEMENT_TIMEOUT_MS=15000

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx
# Development fallback: without keys checkout creates a mock order id so the UI can be
# exercised. In production a missing key REFUSES online payment (503) instead of faking a
# payment that can never complete. Set true only for a staging demo environment.
ALLOW_MOCK_PAYMENTS=false
RAZORPAY_WEBHOOK_SECRET=whsec_xxxx

# --- Admin console (/admin uses this as the password) ---
ADMIN_TOKEN=change-me-long-random-string

# --- Abuse protection: per-IP limit on public write endpoints ---
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# --- Admin brute-force throttle (token guessing) ---
ADMIN_RATE_LIMIT_MAX=120
ADMIN_RATE_LIMIT_WINDOW_MS=60000

# --- Receipt lookups (invoice / track / verify) per IP per minute ---
LOOKUP_RATE_LIMIT_MAX=60

# --- Typeahead suggestions per IP per minute (it queries the DB on every keystroke) ---
SUGGEST_RATE_LIMIT_MAX=120

# --- Abandoned-checkout sweep: minutes between runs (0 disables; default 15) ---
# A pending order whose payment never completes holds stock until this releases it.
STALE_SWEEP_MINUTES=15

# --- Graceful shutdown: how long SIGTERM waits for in-flight requests (ms, default 10000) ---
# Deploys finish open checkouts/webhooks instead of cutting them off mid-transaction.
SHUTDOWN_TIMEOUT_MS=10000

# --- Seed the catalogue on first boot when the products table is empty (default on) ---
# Never runs against a populated table, so operator edits survive redeploys.
SEED_ON_BOOT=true

# --- Server-render cache TTL (ms). Absorbs traffic bursts without stale prices ---
SSR_CACHE_TTL_MS=10000

# --- Cash on Delivery cap (paise). Default 2000000 = ₹20,000 ---
# Keep NEXT_PUBLIC_COD_MAX_PAISE in sync so the checkout UI disables COD at the same point.
COD_MAX_PAISE=2000000
NEXT_PUBLIC_COD_MAX_PAISE=2000000

# --- Shipping policy. Default: free everywhere. ---
# To charge a flat fee below a threshold, e.g. ₹149 fee, free above ₹4,999:
#   SHIPPING_FEE_PAISE=14900
#   FREE_SHIPPING_ABOVE_PAISE=499900
SHIPPING_FEE_PAISE=0
FREE_SHIPPING_ABOVE_PAISE=0
# UI mirrors of the two values above (baked at build time; keep them in sync).
NEXT_PUBLIC_SHIPPING_FEE_PAISE=0
NEXT_PUBLIC_FREE_SHIPPING_ABOVE_PAISE=0

# --- CORS: the storefront origin that may call the API ---
# Single-domain nginx setup: https://yourdomain.com
# Two subdomains:           https://shop.yourdomain.com
# Allowed browser origin(s) for the API. Comma-separated for www + apex.
# Leave empty for same-origin single-domain (/api behind nginx needs no CORS entry).
# In production an empty value blocks cross-origin browser calls (it no longer means "*"),
# and the backend logs a warning at boot.
FRONTEND_URL=http://localhost:3000

# Used by the backend sitemap to build absolute URLs when FRONTEND_URL is unset.
STOREFRONT_URL=http://localhost:3000

# --- Frontend (NEXT_PUBLIC_* are baked in at BUILD time — rebuild to change) ---
# Single domain via nginx: https://yourdomain.com/api   |   two domains: https://api.yourdomain.com
# Where the browser calls the API.
#   Production (single domain behind nginx): /api
#   Local dev without nginx:                http://localhost:9000
# Baked into the JS bundle at build time — changing it needs a rebuild.
NEXT_PUBLIC_BACKEND_URL=/api

# Where *the server* reaches the API (SSR, metadata, /sitemap.xml rewrite).
# Must be absolute and resolvable from the storefront container.
BACKEND_INTERNAL_URL=http://backend:9000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
NEXT_PUBLIC_STORE_NAME=ToolsKart
NEXT_PUBLIC_STORE_PHONE=919999999999
NEXT_PUBLIC_STORE_EMAIL=care@toolskart.in
NEXT_PUBLIC_STORE_GSTIN=00AAAAA0000A1Z5
# Seller postal address printed on invoices
NEXT_PUBLIC_STORE_ADDRESS=Plot 12, MIDC Industrial Area, Pune, Maharashtra 411026
# GST state code of the seller (01-38) — decides CGST+SGST vs IGST on invoices
NEXT_PUBLIC_STORE_STATE_CODE=27
# Public storefront origin, used for canonical/OG URLs and the sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
