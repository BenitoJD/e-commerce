# Copy to .env for local dev
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce
REDIS_URL=redis://localhost:6379
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
PORT=9000
FRONTEND_URL=http://localhost:3000
# Storefront admin login uses this as the password (sent as x-admin-token header)
ADMIN_TOKEN=change-me-long-random-string
# --- Accounts / OTP / transactional email (new) ---
AUTH_SECRET=change-me-long-random-auth-secret
AUTH_RATE_LIMIT_MAX=30
ALLOW_DEV_OTP=false
SMS_PROVIDER=
SMS_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=E-Commerce <care@ecommerce.in>
NOTIFY_INTERVAL_SECONDS=30
# Reverse-proxy hops to trust (docker-compose sets 1 for nginx; false when direct)
TRUST_PROXY=false
STOREFRONT_URL=http://localhost:3000
