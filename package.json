{
  "name": "toolsvilla-clone",
  "version": "0.1.0",
  "private": true,
  "description": "Toolsvilla-like machinery & tools ecommerce — Next.js storefront + Node backend + Razorpay, VPS-ready monorepo",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:backend": "pnpm --filter ./apps/backend dev",
    "dev:storefront": "pnpm --filter ./apps/storefront dev",
    "build": "pnpm -r build",
    "seed": "pnpm --filter ./apps/backend seed"
  },
  "engines": {
    "node": ">=20"
  }
}
